 <Page x:Class= "_3practsheynemanv.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:_3practsheynemanv.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Autho"
      Background="#F5F5F5"><Grid>
    <Border Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16"
                Padding="30,35,30,25">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20"
                                  ShadowDepth="0" Opacity="0.12"/>
        </Border.Effect>

        <StackPanel>
            <Image Source="/Resources/logo.png"
                       Width="70" Height="70"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Авторизация"
                           FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                           Foreground="#2E7D32"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

            <TextBlock Text="Логин"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="#666666"
                           Margin="2,0,0,4"/>
            <TextBox x:Name="txtLogin" Margin="0,0,0,15"
                         Height="38" FontFamily="Segoe UI" FontSize="14"
                         Padding="10,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="#666666"
                           Margin="2,0,0,4"/>
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,10"
                             Height="38" FontFamily="Segoe UI" FontSize="14"
                             Padding="10,0" VerticalContentAlignment="Center"/>

            <TextBlock Visibility="Hidden" x:Name="txtBlockCaptcha" Text="Капча:"/>
            <TextBlock Visibility="Hidden" x:Name="txtBoxCaptcha"/>
            <TextBlock HorizontalAlignment="Center" Visibility="Hidden"
                           x:Name="txtBlockTimer"/>

            <Button x:Name="btnEnter"
                        Content="Войти"
                        Height="42" MinWidth="140" Margin="0,15,0,5"
                        FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                        Foreground="White" Background="#43A047" BorderThickness="0"
                        Cursor="Hand"
                        Click="btnEnter_Click"/>

            <Button x:Name="btnEnterGuests"
                        Content="Войти как гость"
                        Height="42" MinWidth="140" Margin="0"
                        FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                        Foreground="#2E7D32" Background="White"
                        BorderBrush="#2E7D32" BorderThickness="2"
                        Cursor="Hand"
                        Click="btnEnterGuests_Click"/>
        </StackPanel>
    </Border>
</Grid>
</Page>